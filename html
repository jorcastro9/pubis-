   =========================== */

const clone = objeto =>
  JSON.parse(JSON.stringify(objeto));


const load = (key, fallback) => {

  try {

    const saved = localStorage.getItem(key);

    return saved
      ? JSON.parse(saved)
      : clone(fallback);

  } catch {

    return clone(fallback);

  }

};


let data = load(DATA_KEY, PRELOADED);

let week = load(WEEK_KEY, {});

let selected = null;

let editing = null;

let weekStart = getMonday(new Date());


const $ = id =>
  document.getElementById(id);


const esc = value =>
  String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");


function saveData() {

  localStorage.setItem(
    DATA_KEY,
    JSON.stringify(data)
  );

}


function saveWeek() {

  localStorage.setItem(
    WEEK_KEY,
    JSON.stringify(week)
  );

}


function getMonday(date) {

  const d = new Date(date);

  d.setHours(0,0,0,0);

  const day = d.getDay();

  d.setDate(
    d.getDate() +
    (day === 0 ? -6 : 1 - day)
  );

  return d;

}


function iso(date) {

  return (
    date.getFullYear() +
    "-" +
    String(date.getMonth() + 1).padStart(2,"0") +
    "-" +
    String(date.getDate()).padStart(2,"0")
  );

}


function fmt(date, options) {

  return new Intl.DateTimeFormat(
    "es-ES",
    options
  ).format(date);

}


/* ===========================
   CALENDARIO
   =========================== */

function renderWeek() {

  $("weekGrid").innerHTML = "";


  const weekEnd =
    new Date(weekStart);


  weekEnd.setDate(
    weekEnd.getDate() + 6
  );


  $("weekLabel").textContent =
    `${fmt(
      weekStart,
      {
        day:"numeric",
        month:"short"
      }
    )} – ${
      fmt(
        weekEnd,
        {
          day:"numeric",
          month:"short",
          year:"numeric"
        }
      )
    }`;


  const today =
    iso(new Date());


  for (
    let i = 0;
    i < 7;
    i++
  ) {

    const date =
      new Date(weekStart);


    date.setDate(
      date.getDate() + i
    );


    const key =
      iso(date);


    const element =
      document.createElement("div");


    element.className =
      "day" +
      (
        key === today
          ? " today"
          : ""
      );


    const options = [

      `<option value="">
        Descanso
      </option>`,

      ...TYPES.map(type =>

        `<option
          value="${esc(type)}"
          ${
            week[key] === type
              ? "selected"
              : ""
          }
        >
          ${esc(type)}
        </option>`

      )

    ].join("");


    element.innerHTML = `

      <div class="dow">
        ${
          fmt(
            date,
            {weekday:"short"}
          ).replace(".","")
        }
      </div>

      <div class="date">
        ${date.getDate()}
      </div>

      <select>
        ${options}
      </select>

    `;


    element
      .querySelector("select")
      .onchange = event => {

        if (event.target.value) {

          week[key] =
            event.target.value;

        } else {

          delete week[key];

        }

        saveWeek();

      };


    $("weekGrid")
      .appendChild(element);

  }

}


/* ===========================
   TARJETAS
   =========================== */

function renderCards() {

  $("workoutGrid").innerHTML = "";


  TYPES.forEach(type => {

    const button =
      document.createElement("button");


    button.className =
      "workout-card";


    const exercises =
      data[type] || [];


    const count =
      exercises.length;


    button.innerHTML = `

      <div>

        <div class="workout-name">
          ${esc(type)}
        </div>

        <span class="pill">

          ${count}

          ejercicio${count === 1 ? "" : "s"}

        </span>

      </div>


      <div class="workout-meta">

        <span>
          Ver sesión
        </span>

        <span>
          →
        </span>

      </div>

    `;


    button.onclick =
      () => openWorkout(type);


    $("workoutGrid")
      .appendChild(button);

  });

}


/* ===========================
   ABRIR ENTRENAMIENTO
   =========================== */

function openWorkout(type) {

  selected = type;


  $("homeView")
    .classList
    .add("hidden");


  $("detailView")
    .classList
    .add("active");


  $("detailName")
    .textContent =
      type;


  renderExercises();


  scrollTo({
    top:0,
    behavior:"smooth"
  });

}


/* ===========================
   VOLVER
   =========================== */

function closeWorkout() {

  $("detailView")
    .classList
    .remove("active");


  $("homeView")
    .classList
    .remove("hidden");


  selected = null;

  editing = null;


  renderCards();


  scrollTo({
    top:0,
    behavior:"smooth"
  });

}


/* ===========================
   MOSTRAR EJERCICIOS
   =========================== */

function renderExercises() {

  const exercises =
    data[selected] || [];


  $("detailSubtitle")
    .textContent =

    `${exercises.length} ejercicio${
      exercises.length === 1
        ? ""
        : "s"
    }`;


  const host =
    $("exerciseList");


  host.innerHTML = "";


  const blocks =
    [
      ...new Set(
        exercises.map(
          exercise =>
            exercise.block || "Otro"
        )
      )
    ];


  blocks.forEach(block => {

    const heading =
      document.createElement("div");


    heading.className =
      "block-title";


    heading.textContent =
      block;


    host.appendChild(heading);


    exercises.forEach(
      (exercise,index) => {

        if (
          (exercise.block || "Otro")
          !== block
        ) {

          return;

        }


        const card =
          document.createElement("div");


        card.className =
          "card exercise-card";


        const notes = [

          exercise.explanation
            ? `
              <div class="note">
                <b>Explicación:</b>
                ${esc(exercise.explanation)}
              </div>
            `
            : "",


          exercise.rest
            ? `
              <div class="note">
                <b>Descanso:</b>
                ${esc(exercise.rest)}
              </div>
            `
            : "",


          exercise.substitution
            ? `
              <div class="note">
                <b>Sustitución:</b>
                ${esc(exercise.substitution)}
              </div>
            `
            : ""

        ].join("");


        card.innerHTML = `

          <div class="exercise-title">
            ${
              esc(
                exercise.name ||
                "Ejercicio"
              )
            }
          </div>


          <div class="exercise-number">
            Ejercicio ${index + 1}
          </div>


          <div class="metrics">


            <div class="metric">

              <div class="metric-label">
                Peso
              </div>

              <div class="metric-value">
                ${
                  esc(
                    exercise.weight ||
                    "—"
                  )
                }
              </div>

            </div>


            <div class="metric">

              <div class="metric-label">
                Series
              </div>

              <div class="metric-value">
                ${
                  esc(
                    exercise.sets ||
                    "—"
                  )
                }
              </div>

            </div>


            <div class="metric">

              <div class="metric-label">
                Reps / tiempo
              </div>

              <div class="metric-value">
                ${
                  esc(
                    exercise.reps ||
                    "—"
                  )
                }
              </div>

            </div>


            <div class="metric">

              <div class="metric-label">
                Dolor EVA
              </div>

              <div class="metric-value">
                ${
                  esc(
                    exercise.pain ||
                    "—"
                  )
                }
              </div>

            </div>


            <div class="metric">

              <div class="metric-label">
                RPE
              </div>

              <div class="metric-value">
                ${
                  esc(
                    exercise.rpe ||
                    "—"
                  )
                }
              </div>

            </div>


          </div>


          ${notes}


          ${
            exercise.video

              ? `
                <a
                  class="video-btn"
                  target="_blank"
                  rel="noopener"
                  href="${esc(exercise.video)}"
                >
                  ▶ Ver vídeo en YouTube
                </a>
              `

              : ""
          }


          <div class="edit-row">

            <button
              class="secondary-btn edit"
              data-i="${index}"
            >
              Editar
            </button>


            <button
              class="danger-btn del"
              data-i="${index}"
            >
              Eliminar
            </button>

          </div>

        `;


        host.appendChild(card);

      }

    );

  });


  host
    .querySelectorAll(".edit")
    .forEach(button => {

      button.onclick =
        () =>
          openModal(
            Number(button.dataset.i)
          );

    });


  host
    .querySelectorAll(".del")
    .forEach(button => {

      button.onclick =
        () =>
          deleteExercise(
            Number(button.dataset.i)
          );

    });

}


/* ===========================
   FORMULARIO
   =========================== */

const fields = {

  block: $("fBlock"),

  name: $("fName"),

  weight: $("fWeight"),

  sets: $("fSets"),

  reps: $("fReps"),

  rest: $("fRest"),

  pain: $("fPain"),

  rpe: $("fRpe"),

  explanation:
    $("fExplanation"),

  substitution:
    $("fSubstitution"),

  video:
    $("fVideo")

};


/* ===========================
   ABRIR MODAL
   =========================== */

function openModal(index = null) {

  editing = index;


  $("modalTitle").textContent =

    index === null

      ? "Añadir ejercicio"

      : "Editar ejercicio";


  const exercise =

    index === null

      ? {}

      : data[selected][index];


  Object
    .entries(fields)
    .forEach(
      ([key,element]) => {

        element.value =

          exercise[key]

          ||

          (
            key === "block"
              ? "Movilidad"
              : ""
          );

      }
    );


  $("exerciseModal")
    .classList
    .add("open");

}


/* ===========================
   CERRAR MODAL
   =========================== */

function closeModal() {

  $("exerciseModal")
    .classList
    .remove("open");


  editing = null;

}


/* ===========================
   GUARDAR EJERCICIO
   =========================== */

function saveExercise() {

  if (
    !fields.name.value.trim()
  ) {

    alert(
      "Introduce el nombre del ejercicio."
    );

    return;

  }


  const exercise = {};


  Object
    .entries(fields)
    .forEach(
      ([key,element]) => {

        exercise[key] =
          element.value.trim();

      }
    );


  if (editing === null) {

    data[selected]
      .push(exercise);

  } else {

    data[selected][editing] =
      exercise;

  }


  saveData();

  closeModal();

  renderExercises();

}


/* ===========================
   ELIMINAR EJERCICIO
   =========================== */

function deleteExercise(index) {

  const exercise =
    data[selected][index];


  const confirmation =
    confirm(
      `¿Eliminar "${exercise.name}"?`
    );


  if (!confirmation) {

    return;

  }


  data[selected]
    .splice(index,1);


  saveData();

  renderExercises();

}


/* ===========================
   BOTONES
   =========================== */

$("backBtn").onclick =
  closeWorkout;


$("addExerciseBtn").onclick =
  () => openModal();


$("cancelBtn").onclick =
  closeModal;


$("saveBtn").onclick =
  saveExercise;


$("todayBtn").onclick =
  () => {

    weekStart =
      getMonday(new Date());

    renderWeek();

  };


$("exerciseModal").onclick =
  event => {

    if (
      event.target ===
      $("exerciseModal")
    ) {

      closeModal();

    }

  };


/* ===========================
   INICIAR APP
   =========================== */

renderWeek();

renderCards();

</script>

</body>
</html>