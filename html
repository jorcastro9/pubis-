        </div>

      </div>

    </div>

    <div class="workout-grid" id="workoutGrid"></div>


    <p class="footer-note">
      Tus cambios se guardan en este dispositivo mediante el almacenamiento local del navegador.
    </p>

  </section>


  <!-- DETALLE ENTRENAMIENTO -->

  <section id="detailView" class="detail">

    <div class="detail-top">

      <button class="back-btn" id="backBtn">
        ←
      </button>

      <div class="detail-title">

        <h2 id="detailName"></h2>

        <p id="detailSubtitle"></p>

      </div>

    </div>

    <div id="exerciseList"></div>


    <button
      class="primary-btn"
      id="addExerciseBtn"
      style="margin-top:14px"
    >
      + Añadir ejercicio
    </button>

  </section>

</main>


<!-- MODAL EDICIÓN -->

<div class="modal" id="exerciseModal">

  <div class="sheet">

    <h3 id="modalTitle">
      Añadir ejercicio
    </h3>


    <div class="form-grid">

      <div class="field full">

        <label>Bloque</label>

        <select id="fBlock">

          <option>Movilidad</option>

          <option>Fuerza</option>

          <option>Fuerza específica</option>

          <option>Otro</option>

        </select>

      </div>


      <div class="field full">

        <label>Ejercicio</label>

        <input id="fName" />

      </div>


      <div class="field">

        <label>Peso</label>

        <input
          id="fWeight"
          placeholder="Ej. 3 kg"
        />

      </div>


      <div class="field">

        <label>Series</label>

        <input
          id="fSets"
          inputmode="numeric"
        />

      </div>


      <div class="field">

        <label>Repeticiones / tiempo</label>

        <input
          id="fReps"
          placeholder="Ej. 5 / 20 seg"
        />

      </div>


      <div class="field">

        <label>Descanso</label>

        <input id="fRest" />

      </div>


      <div class="field">

        <label>Dolor (EVA)</label>

        <input id="fPain" />

      </div>


      <div class="field">

        <label>RPE</label>

        <input id="fRpe" />

      </div>


      <div class="field full">

        <label>Explicación</label>

        <textarea id="fExplanation"></textarea>

      </div>


      <div class="field full">

        <label>Sustitución opción 1</label>

        <input id="fSubstitution" />

      </div>


      <div class="field full">

        <label>Vídeo de YouTube</label>

        <input
          id="fVideo"
          inputmode="url"
          placeholder="https://youtube.com/..."
        />

      </div>

    </div>


    <div class="sheet-actions">

      <button
        class="secondary-btn"
        id="cancelBtn"
      >
        Cancelar
      </button>


      <button
        class="primary-btn"
        id="saveBtn"
      >
        Guardar
      </button>

    </div>

  </div>

</div>


