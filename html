<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0b1220" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Entrenos" />

  <title>Plan semanal de entrenamiento</title>

  <style>
    :root {
      --bg: #0b1220;
      --card: #111827;
      --card2: #172033;
      --line: #273449;
      --text: #f8fafc;
      --muted: #9ca3af;
      --blue: #60a5fa;
      --green: #6fb12a;
      --red: #ef4444;
      --radius: 22px;
      --shadow: 0 14px 36px rgba(0,0,0,.25);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      background: var(--bg);
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont,
        "SF Pro Text", "Segoe UI", sans-serif;

      background:
        radial-gradient(
          circle at top right,
          rgba(96,165,250,.10),
          transparent 30%
        ),
        var(--bg);

      padding:
        max(16px, env(safe-area-inset-top))
        14px
        max(26px, env(safe-area-inset-bottom));
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .app {
      max-width: 820px;
      margin: auto;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
      margin-bottom: 18px;
    }

    .eyebrow {
      margin: 0 0 5px;
      color: var(--blue);
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .13em;
    }

    h1 {
      font-size: clamp(29px, 7vw, 44px);
      line-height: 1.02;
      margin: 0 0 7px;
    }

    .subtitle {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.45;
    }

    .card {
      background:
        linear-gradient(
          180deg,
          rgba(255,255,255,.025),
          rgba(255,255,255,0)
        ),
        var(--card);

      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .icon-btn,
    .back-btn {
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--text);
      border-radius: 14px;
      min-height: 44px;
      padding: 0 13px;
    }

    /* CALENDARIO */

    .calendar-card {
      padding: 16px;
      margin-bottom: 18px;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .section-head h2 {
      font-size: 19px;
      margin: 0;
    }

    .small {
      color: var(--muted);
      font-size: 13px;
    }

    .week-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(86px, 1fr));
      gap: 9px;
      overflow-x: auto;
      padding-bottom: 4px;
      scroll-snap-type: x proximity;
    }

    .day {
      min-width: 86px;
      scroll-snap-align: start;
      background: var(--card2);
      border: 1px solid var(--line);
      border-radius: 17px;
      padding: 11px 9px;
    }

    .day.today {
      outline: 2px solid var(--blue);
      outline-offset: -2px;
    }

    .dow {
      font-size: 11px;
      color: var(--muted);
      font-weight: 900;
      text-transform: uppercase;
      margin-bottom: 3px;
    }

    .date {
      font-size: 22px;
      font-weight: 900;
      margin-bottom: 9px;
    }

    .day select {
      width: 100%;
      background: #0d1524;
      color: var(--text);
      border: 1px solid var(--line);
      border-radius: 11px;
      padding: 8px 6px;
      font-size: 12px;
    }

    /* TARJETAS ENTRENAMIENTOS */

    .workout-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 12px;
    }

    .workout-card {
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--text);
      padding: 17px;
      border-radius: var(--radius);
      text-align: left;
      min-height: 128px;

      display: flex;
      flex-direction: column;
      justify-content: space-between;

      box-shadow: var(--shadow);
    }

    .workout-card:active {
      transform: scale(.98);
    }

    .workout-name {
      font-size: 18px;
      font-weight: 900;
      margin-bottom: 10px;
    }

    .pill {
      display: inline-flex;
      padding: 6px 9px;
      border-radius: 999px;

      background: rgba(96,165,250,.1);
      border: 1px solid rgba(96,165,250,.23);

      color: #bfdbfe;
      font-size: 12px;
      font-weight: 800;
    }

    .workout-meta {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 13px;
    }

    /* DETALLE */

    .home.hidden {
      display: none;
    }

    .detail {
      display: none;
    }

    .detail.active {
      display: block;
    }

    .detail-top {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 14px;
    }

    .back-btn {
      width: 44px;
      padding: 0;
      font-size: 20px;
    }

    .detail-title {
      flex: 1;
    }

    .detail-title h2 {
      font-size: 25px;
      margin: 0 0 4px;
    }

    .detail-title p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
    }

    .block-title {
      margin: 18px 2px 9px;
      padding: 9px 12px;
      border-radius: 12px;

      background: var(--green);
      color: #fff;

      font-size: 14px;
      font-weight: 900;

      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .exercise-list {
      display: grid;
      gap: 11px;
    }

    .exercise-card {
      padding: 15px;
    }

    .exercise-title {
      font-size: 18px;
      font-weight: 900;
      margin: 0 0 4px;
    }

    .exercise-number {
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 13px;
    }

    .metrics {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 8px;
      margin-bottom: 11px;
    }

    .metric {
      background: var(--card2);
      border: 1px solid var(--line);
      border-radius: 13px;
      padding: 10px;
    }

    .metric-label {
      color: var(--muted);
      font-size: 10px;
      text-transform: uppercase;
      font-weight: 900;
      letter-spacing: .04em;
      margin-bottom: 4px;
    }

    .metric-value {
      font-size: 16px;
      font-weight: 900;
      overflow-wrap: anywhere;
    }

    .note {
      margin-top: 9px;
      padding: 11px;

      background: rgba(255,255,255,.025);
      border: 1px solid var(--line);

      border-radius: 13px;

      color: #d1d5db;
      font-size: 13px;
      line-height: 1.45;
    }

    .note b {
      color: var(--text);
    }

    .video-btn {
      display: flex;
      align-items: center;
      justify-content: center;

      text-decoration: none;

      margin-top: 10px;

      background: var(--red);
      color: white;

      border-radius: 13px;
      padding: 11px;

      font-weight: 900;
    }

    .edit-row {
      display: flex;
      gap: 8px;
      margin-top: 10px;
    }

    .secondary-btn,
    .danger-btn,
    .primary-btn {
      border-radius: 13px;
      padding: 11px 13px;
      font-weight: 900;
      border: 1px solid var(--line);
    }

    .secondary-btn {
      background: var(--card2);
      color: var(--text);
    }

    .danger-btn {
      background: rgba(251,113,133,.08);
      color: #fecdd3;
      border-color: rgba(251,113,133,.25);
    }

    .primary-btn {
      background: var(--blue);
      color: #06111f;
      border: none;
      width: 100%;
    }

    .footer-note {
      margin-top: 18px;
      text-align: center;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;
    }

    /* MODAL */

    .modal {
      position: fixed;
      inset: 0;

      display: none;
      align-items: flex-end;
      justify-content: center;

      background: rgba(0,0,0,.62);

      z-index: 99;
      padding: 12px;
    }

    .modal.open {
      display: flex;
    }

    .sheet {
      width: min(760px,100%);
      max-height: 90vh;

      overflow: auto;

      background: var(--card);

      border: 1px solid var(--line);

      border-radius: 26px 26px 20px 20px;

      padding: 18px;
    }

    .sheet h3 {
      margin: 0 0 14px;
      font-size: 22px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 10px;
    }

    .field.full {
      grid-column: 1/-1;
    }

    label {
      display: block;
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 5px;
    }

    input,
    textarea,
    .sheet select {
      width: 100%;

      background: #0d1524;
      color: var(--text);

      border: 1px solid var(--line);

      border-radius: 12px;

      padding: 11px;
      outline: none;
    }

    textarea {
      min-height: 74px;
      resize: vertical;
    }

    .sheet-actions {
      display: flex;
      gap: 8px;
      margin-top: 14px;
    }

    .sheet-actions > * {
      flex: 1;
    }

    @media(min-width:650px) {

      .workout-grid {
        grid-template-columns: repeat(3,1fr);
      }

      .metrics {
        grid-template-columns: repeat(5,1fr);
      }

    }

    @media(max-width:430px) {

      .workout-grid {
        grid-template-columns: 1fr;
      }

      .metrics {
        grid-template-columns: repeat(2,1fr);
      }

    }

  </style>
</head>

